0:["QCYXwBbTTzYcrpJvLddLD",[[["",{"children":["blog",{"children":[["slug","nz-fraud-statistics-2025","d"],{"children":["__PAGE__?{\"slug\":\"nz-fraud-statistics-2025\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["blog",{"children":[["slug","nz-fraud-statistics-2025","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"headline\":\"NZ Fraud Statistics 2025: $3 Billion Lost — The Full Picture\",\"description\":\"New Zealand lost $3 billion to fraud and scams in 2025 — a 30% year-on-year increase. Full breakdown of who is targeted, how, and what it means for you.\",\"image\":\"https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?w=1600&q=80\",\"datePublished\":\"2026-01-15\",\"dateModified\":\"2026-05-17\",\"author\":{\"@type\":\"Organization\",\"name\":\"FraudProtection.co.nz Editorial Team\",\"url\":\"https://www.fraudprotection.co.nz/about/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"FraudProtection.co.nz\",\"url\":\"https://www.fraudprotection.co.nz/\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.fraudprotection.co.nz/favicon-32x32.png\"}},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.fraudprotection.co.nz/blog/nz-fraud-statistics-2025/\"}}"}}],["$","nav",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3","children":["$","ol",null,{"className":"flex flex-wrap items-center gap-1 text-sm text-slate-500","children":[["$","li",null,{"children":["$","$L2",null,{"href":"/","className":"hover:text-red-600","children":"Home"}]}],["$","li",null,{"children":["$","span",null,{"className":"text-slate-300 mx-1","children":"/"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/blog","className":"hover:text-red-600","children":"Blog"}]}],["$","li",null,{"children":["$","span",null,{"className":"text-slate-300 mx-1","children":"/"}]}],["$","li",null,{"className":"text-slate-700 font-medium truncate max-w-[200px]","children":"NZ Fraud Statistics 2025: $3 Billion Lost — The Full Picture"}]]}]}],["$","section",null,{"className":"relative text-white min-h-[45vh] flex items-end","children":[["$","div",null,{"className":"absolute inset-0 bg-cover bg-center","style":{"backgroundImage":"url(https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?w=1600&q=80)"}}],["$","div",null,{"className":"absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-900/60 to-slate-900/10"}],["$","div",null,{"className":"relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 w-full","children":[["$","div",null,{"className":"flex flex-wrap items-center gap-2 mb-3","children":[["$","span",null,{"className":"text-xs px-2 py-0.5 rounded-full font-medium bg-orange-100 text-orange-700","children":"Statistics"}],["$","span",null,{"className":"text-xs text-slate-300","children":"8 min read"}],["$","span",null,{"className":"text-xs text-slate-400","children":"·"}],["$","span",null,{"className":"text-xs text-slate-400","children":"15 January 2026"}]]}],["$","h1",null,{"className":"text-3xl sm:text-4xl font-bold mb-3 max-w-3xl drop-shadow-md","children":"NZ Fraud Statistics 2025: $3 Billion Lost — The Full Picture"}],["$","p",null,{"className":"text-slate-200 max-w-2xl text-sm","children":"New Zealand lost $3 billion to scams and fraud in 2025 — a 30% increase from the year before. We break down who is being targeted, how, and what it means for your protection."}]]}]]}],["$","section",null,{"className":"py-12 bg-white","children":["$","div",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8","children":["$","div",null,{"className":"grid lg:grid-cols-3 gap-10","children":[["$","article",null,{"className":"lg:col-span-2","children":[["$","div",null,{"className":"flex items-center gap-3 text-xs text-slate-500 border-l-2 border-red-300 pl-4 mb-8","children":["$","div",null,{"children":[["$","span",null,{"className":"font-medium text-slate-700","children":"Written by "}],["$","$L2",null,{"href":"/about/","className":"text-red-600 hover:underline font-medium","children":"FraudProtection.co.nz Editorial Team"}],["$","span",null,{"className":"mx-2","children":"·"}],["$","span",null,{"children":["Updated ","January 2026"]}]]}]}],["$","div",null,{"className":"prose prose-sm max-w-none","children":[["$","p","0",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"New Zealand has reached a grim milestone: according to the 2025 Netsafe/GASA NZ Scam Report, New Zealanders lost $3 billion to scams and fraud — a 30% increase from 2024, and representing one of the highest per-capita scam loss rates in the developed world."}],["$","p","1",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"The statistics paint a stark picture of the scale and sophistication of fraud targeting New Zealanders in 2025."}],["$","h2","2",{"className":"text-xl font-bold text-slate-900 mt-8 mb-3","children":"Key findings from the Netsafe/GASA 2025 Report:"}],["$","p","3",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"23% of New Zealand adults lost money to scams in 2025 — nearly one in four. The average individual loss stood at $3,352, though investment scam victims faced losses many times higher. Alarmingly, 82% of NZ adults encounter scams every week, and only 36% of those who reported fraud to their bank recovered their funds."}],["$","p","4",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"Perhaps most worryingly, only 10% of victims managed to stop the scam in time to prevent any loss."}],["$","h2","5",{"className":"text-xl font-bold text-slate-900 mt-8 mb-3","children":"The most costly fraud types:"}],["$","p","6",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"Investment scams — particularly fake cryptocurrency trading platforms and romance-to-investment scams — remained the highest-value category, with individual losses often exceeding $20,000-$100,000. Business Email Compromise continued to grow, targeting construction, professional services, and property firms with high-value payment diversions."}],["$","p","7",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"Identity theft and account takeover fraud grew significantly, enabled by the increasing availability of stolen credentials from international data breaches. Phishing and smishing (SMS phishing) affected a broad cross-section of the population, with impersonation of IRD, NZ Post, and major banks the most common pretexts."}],["$","h2","8",{"className":"text-xl font-bold text-slate-900 mt-8 mb-3","children":"Why is NZ so heavily targeted?"}],["$","p","9",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"Experts identify several factors: New Zealand's high internet penetration and digital banking adoption creates a large attack surface; the relatively high per-capita income makes NZ an attractive target; and the country's relatively small population means fraud response resources are limited compared to the scale of the problem."}],["$","h2","10",{"className":"text-xl font-bold text-slate-900 mt-8 mb-3","children":"What this means for individuals and businesses:"}],["$","p","11",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"For individuals, the data reinforces that fraud is not an edge case — it is a near-universal experience. Having protective measures in place, knowing what to do when targeted, and understanding the limits of bank protection are now essential financial literacy."}],["$","p","12",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"For businesses, the rising threat of commercial fraud — BEC, ransomware, employee theft, and social engineering — underlines the importance of both preventive controls and appropriate insurance cover. The average NZ business fraud loss significantly exceeds the annual cost of commercial crime or cyber insurance."}],["$","h2","13",{"className":"text-xl font-bold text-slate-900 mt-8 mb-3","children":"The recovery challenge:"}],["$","p","14",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"One of the most sobering statistics is the recovery rate. Only 36% of victims who reported to their bank recovered their funds. For authorised scam payments — where the victim was tricked into sending money — recovery is particularly difficult and often impossible once funds have been moved overseas."}],["$","p","15",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"This gap in financial protection is driving growing calls in NZ for a mandatory bank reimbursement code similar to those adopted in the UK and Australia, where banks are required to reimburse scam victims in defined circumstances."}],["$","h2","16",{"className":"text-xl font-bold text-slate-900 mt-8 mb-3","children":"Looking ahead:"}],["$","p","17",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"AI-powered fraud tools are making scams more sophisticated — deepfake voice and video technology is now being used to impersonate executives and family members, and AI-generated phishing messages are increasingly difficult to distinguish from legitimate communications. The 2026 outlook from fraud experts suggests continued growth in both sophistication and volume."}],["$","p","18",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"The most important step any New Zealander — individual or business — can take is to understand their exposure and have appropriate protection and response plans in place."}]]}],false]}],["$","div",null,{"className":"space-y-5","children":[["$","div",null,{"className":"bg-red-600 text-white rounded-xl p-5 sticky top-4","children":[["$","h3",null,{"className":"font-bold mb-2","children":"Business Insurance Quotes"}],["$","p",null,{"className":"text-red-100 text-sm mb-4","children":"Get a tailored quote for commercial crime, fidelity, or cyber insurance from a licensed NZ adviser."}],["$","$L2",null,{"href":"/quote","className":"block w-full bg-white text-red-700 hover:bg-red-50 font-bold py-2.5 rounded-lg text-center text-sm transition-colors","children":"Get Free Quote →"}]]}],["$","div",null,{"className":"border-2 border-slate-200 rounded-xl p-5","children":[["$","h3",null,{"className":"font-semibold text-slate-900 mb-3 text-sm","children":"Immediate Help"}],["$","div",null,{"className":"space-y-2","children":[["$","a",null,{"href":"tel:0508638723","className":"block text-sm font-bold text-red-600 hover:text-red-700","children":"Netsafe: 0508 638 723"}],["$","a",null,{"href":"tel:105","className":"block text-sm font-bold text-red-600 hover:text-red-700","children":"NZ Police: 105"}],["$","a",null,{"href":"tel:0800432273","className":"block text-sm font-bold text-red-600 hover:text-red-700","children":"IDCARE: 0800 432 273"}],["$","a",null,{"href":"tel:0800434566","className":"block text-sm text-red-600 hover:text-red-700","children":"FMA: 0800 434 566"}]]}]]}],["$","div",null,{"className":"border-2 border-slate-200 rounded-xl p-5","children":[["$","h3",null,{"className":"font-semibold text-slate-900 mb-3 text-sm","children":"Explore More"}],["$","div",null,{"className":"space-y-2","children":[["$","$L2",null,{"href":"/personal","className":"block text-sm text-red-600 hover:text-red-700","children":"Personal Protection →"}],["$","$L2",null,{"href":"/business","className":"block text-sm text-red-600 hover:text-red-700","children":"Business Protection →"}],["$","$L2",null,{"href":"/providers","className":"block text-sm text-red-600 hover:text-red-700","children":"View All Providers →"}],["$","$L2",null,{"href":"/blog","className":"block text-sm text-red-600 hover:text-red-700","children":"All Articles →"}]]}]]}]]}]]}]}]}],["$","section",null,{"className":"py-12 bg-gradient-to-r from-red-700 to-red-900 text-white","children":["$","div",null,{"className":"max-w-3xl mx-auto px-4 text-c