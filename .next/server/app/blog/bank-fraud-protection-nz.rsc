0:["u6hGtpdYYJcSGA2fMWGaX",[[["",{"children":["blog",{"children":[["slug","bank-fraud-protection-nz","d"],{"children":["__PAGE__?{\"slug\":\"bank-fraud-protection-nz\"}",{}]}]}]},"$undefined","$undefined",true],["",{"children":["blog",{"children":[["slug","bank-fraud-protection-nz","d"],{"children":["__PAGE__",{},[["$L1",[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"headline\":\"Does Your Bank Really Protect You from Fraud? The Full Truth\",\"description\":\"NZ banks promise fraud protection but the details matter. Learn what your bank is actually obligated to cover, when they can decline claims, and what to do if they do.\",\"image\":\"https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=1600&q=80\",\"datePublished\":\"2026-05-05\",\"dateModified\":\"2026-05-17\",\"author\":{\"@type\":\"Organization\",\"name\":\"FraudProtection.co.nz Editorial Team\",\"url\":\"https://www.fraudprotection.co.nz/about/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"FraudProtection.co.nz\",\"url\":\"https://www.fraudprotection.co.nz/\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.fraudprotection.co.nz/favicon-32x32.png\"}},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.fraudprotection.co.nz/blog/bank-fraud-protection-nz/\"}}"}}],["$","nav",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3","children":["$","ol",null,{"className":"flex flex-wrap items-center gap-1 text-sm text-slate-500","children":[["$","li",null,{"children":["$","$L2",null,{"href":"/","className":"hover:text-red-600","children":"Home"}]}],["$","li",null,{"children":["$","span",null,{"className":"text-slate-300 mx-1","children":"/"}]}],["$","li",null,{"children":["$","$L2",null,{"href":"/blog","className":"hover:text-red-600","children":"Blog"}]}],["$","li",null,{"children":["$","span",null,{"className":"text-slate-300 mx-1","children":"/"}]}],["$","li",null,{"className":"text-slate-700 font-medium truncate max-w-[200px]","children":"Does Your Bank Really Protect You from Fraud? The Full Truth"}]]}]}],["$","section",null,{"className":"relative text-white min-h-[45vh] flex items-end","children":[["$","div",null,{"className":"absolute inset-0 bg-cover bg-center","style":{"backgroundImage":"url(https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=1600&q=80)"}}],["$","div",null,{"className":"absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-900/60 to-slate-900/10"}],["$","div",null,{"className":"relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 w-full","children":[["$","div",null,{"className":"flex flex-wrap items-center gap-2 mb-3","children":[["$","span",null,{"className":"text-xs px-2 py-0.5 rounded-full font-medium bg-slate-100 text-slate-700","children":"Personal"}],["$","span",null,{"className":"text-xs text-slate-300","children":"8 min read"}],["$","span",null,{"className":"text-xs text-slate-400","children":"·"}],["$","span",null,{"className":"text-xs text-slate-400","children":"5 May 2026"}]]}],["$","h1",null,{"className":"text-3xl sm:text-4xl font-bold mb-3 max-w-3xl drop-shadow-md","children":"Does Your Bank Really Protect You from Fraud? The Full Truth"}],["$","p",null,{"className":"text-slate-200 max-w-2xl text-sm","children":"Every major bank promises fraud protection. But what are they actually obligated to cover — and when can they decline your claim? We break it all down."}]]}]]}],["$","section",null,{"className":"py-12 bg-white","children":["$","div",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8","children":["$","div",null,{"className":"grid lg:grid-cols-3 gap-10","children":[["$","article",null,{"className":"lg:col-span-2","children":[["$","div",null,{"className":"flex items-center gap-3 text-xs text-slate-500 border-l-2 border-red-300 pl-4 mb-8","children":["$","div",null,{"children":[["$","span",null,{"className":"font-medium text-slate-700","children":"Written by "}],["$","$L2",null,{"href":"/about/","className":"text-red-600 hover:underline font-medium","children":"FraudProtection.co.nz Editorial Team"}],["$","span",null,{"className":"mx-2","children":"·"}],["$","span",null,{"children":["Updated ","May 2026"]}]]}]}],["$","div",null,{"className":"prose prose-sm max-w-none","children":[["$","p","0",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"Every major bank advertises strong fraud protection. ANZ, BNZ, ASB, Westpac, and Kiwibank all offer some form of \"zero liability\" or \"online banking guarantee\" for fraud victims. But the protection these guarantees provide is more limited — and more conditional — than many customers realise."}],["$","p","1",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"Here's the honest breakdown of what bank fraud protection actually covers."}],["$","h2","2",{"className":"text-xl font-bold text-slate-900 mt-8 mb-3","children":"What banks are obligated to cover"}],["$","p","3",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"All five major banks have made voluntary commitments to reimburse customers for \"unauthorised\" transactions — meaning transactions that were initiated by a criminal without your involvement or knowledge."}],["$","p","4",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"This covers scenarios like:\n- A criminal uses your card details (obtained through a data breach or skimming) to make purchases\n- A hacker gains access to your internet banking and transfers money out without your involvement\n- Someone physically steals your card and makes purchases after you've reported it stolen"}],["$","p","5",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"Under their zero-liability policies, banks commit to reimburse these losses when reported promptly."}],["$","h2","6",{"className":"text-xl font-bold text-slate-900 mt-8 mb-3","children":"What banks are NOT required to cover — and often don't"}],["$","p","7",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"The critical distinction is between \"unauthorised\" and \"authorised but fraudulent\" transactions."}],["$","p","8",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"If you were tricked — by a phishing email, a phone scammer, or a fake investment platform — into authorising a payment yourself, the bank typically does not have an automatic obligation to reimburse you. You authorised the payment; the fact that you were deceived is not the bank's legal responsibility."}],["$","p","9",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"This covers many of the most common and costly fraud types:\n- Authorised push payment scams (you were tricked into sending money to a fraudster)\n- Investment scams where you voluntarily transferred funds to a fake platform\n- Romance scams where you sent money to someone you met online\n- Any scenario where you willingly initiated the payment, even under false pretences"}],["$","h2","10",{"className":"text-xl font-bold text-slate-900 mt-8 mb-3","children":"When banks can (and do) decline fraud claims"}],["$","p","11",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"Banks can also decline or reduce reimbursement for unauthorised transactions if they determine you:\n- Failed to maintain adequate security (e.g., shared your PIN with someone)\n- Were negligent in protecting your credentials\n- Delayed reporting the fraud unreasonably\n- Used the device or account in violation of the bank's terms and conditions\n- Were complicit in the fraud (rare but relevant)"}],["$","h2","12",{"className":"text-xl font-bold text-slate-900 mt-8 mb-3","children":"The grey areas"}],["$","p","13",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"The line between \"authorised\" and \"unauthorised\" isn't always clear. If a criminal obtained your credentials through a phishing attack and then initiated transfers from your account, is that unauthorised (a criminal using your credentials without your direct participation) or authorised (they acted as your agent using your login)?"}],["$","p","14",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"Banks handle these cases individually. Some have improved their approach to refunding customers in borderline cases, particularly when the fraud patterns are well-known and the customer had reasonable security practices."}],["$","h2","15",{"className":"text-xl font-bold text-slate-900 mt-8 mb-3","children":"How to maximise your chance of a refund"}],["$","ol","16",{"className":"space-y-2 my-4","children":[["$","li","0",{"className":"flex items-start gap-2 text-slate-700 text-sm","children":[["$","span",null,{"className":"text-red-600 font-bold flex-shrink-0 mt-0.5","children":[1,"."]}],"Report immediately — the faster you report, the better your chances. Within 24 hours is ideal."]}],["$","li","1",{"className":"flex items-start gap-2 text-slate-700 text-sm","children":[["$","span",null,{"className":"text-red-600 font-bold flex-shrink-0 mt-0.5","children":[2,"."]}],"Don't delay because you're embarrassed — banks see all types of fraud."]}],["$","li","2",{"className":"flex items-start gap-2 text-slate-700 text-sm","children":[["$","span",null,{"className":"text-red-600 font-bold flex-shrink-0 mt-0.5","children":[3,"."]}],"Document everything about how the fraud happened."]}],["$","li","3",{"className":"flex items-start gap-2 text-slate-700 text-sm","children":[["$","span",null,{"className":"text-red-600 font-bold flex-shrink-0 mt-0.5","children":[4,"."]}],"Be clear about whether you authorised the payment or whether it was taken without your knowledge."]}],["$","li","4",{"className":"flex items-start gap-2 text-slate-700 text-sm","children":[["$","span",null,{"className":"text-red-600 font-bold flex-shrink-0 mt-0.5","children":[5,"."]}],"If your claim is declined, escalate to your bank's internal dispute resolution process."]}],["$","li","5",{"className":"flex items-start gap-2 text-slate-700 text-sm","children":[["$","span",null,{"className":"text-red-600 font-bold flex-shrink-0 mt-0.5","children":[6,"."]}],"If that fails, complain to the Banking Ombudsman (bankomb.org.nz) — the Ombudsman has resolved many cases in customers' favour where banks initially declined."]}]]}],["$","h2","17",{"className":"text-xl font-bold text-slate-900 mt-8 mb-3","children":"The broader gap: no mandatory scam reimbursement code"}],["$","p","18",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"In the UK, banks are required by regulation to reimburse most authorised push payment scam losses (subject to a customer contribution). Australia has adopted a similar framework. We have not yet mandated this — banks here operate on voluntary codes, which are less comprehensive and enforceable."}],["$","p","19",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"This is the most significant gap in personal fraud protection. Until it changes, the practical reality is that for scam losses (where you sent money under false pretences), recovery is uncertain."}],["$","p","20",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"The Banking Ombudsman's approach offers some protection, and some cases — particularly where the bank had fraud warnings they failed to act on — have been resolved in customers' favour even for authorised payments."}],["$","p","21",{"className":"text-slate-700 leading-relaxed text-sm my-4","children":"Understanding this gap is important when thinking about your overall financial protection."}]]}],["$","div",null,{"className":"mt-12","children":[["$","h2",null,{"className":"text-lg font-bold text-slate-900 mb-4","children":"Related Articles"}],["$","div",null,{"className":"grid sm:grid-cols-3 gap-4","children":[["$","$L2","protect-yourself-online-scams-nz",{"href":"/blog/protect-yourself-o